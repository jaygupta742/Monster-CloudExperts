function checkFilled() {
    var inputVal = document.getElementById("ss");
    if (inputVal.value == "High") {
        inputVal.style.backgroundColor = "yellow";
    }
    else if (inputVal.value == "Medium") {
        inputVal.style.backgroundColor = "Orange";
    }
    else{
        inputVal.style.backgroundColor = "pink";
    }
}
 
checkFilled();
oppmail();
