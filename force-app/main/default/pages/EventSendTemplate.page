    function checkFilled() {
        var inputVal = document.getElementById("ss");
        if (inputVal.value == "High") {
            inputVal.style.backgroundColor = "yellow";
        }
        else if (inputVal.value == "Medium") {
            inputVal.style.backgroundColor = "Orange";
        }
            else{
                inputVal.style.backgroundColor = "pink";
            }
    }
    
    checkFilled();
    evemail();
    </script>
    
    
    <apex:form >
        <apex:pageBlock title="Send Email">
            <center>
                <apex:commandButton value="Send Email" action="{!evemail}"/>
            </center>
            <apex:pageBlockSection >
                <apex:outputField label="Account" value="{!e.WhatId}"/>
                <apex:outputField label="AccountID" value="{!e.Account.AccountID__c}"/>
                
                <apex:outputField label="Status" value="{!e.Account.AccountStatus__c}"/>
                <apex:outputtext label="Contact" value="{!ContactName}"/>
                <apex:OutputText label="Event Source" value="{!e.Event_Source__c}"/>
                <!---<apex:outputText label="Opportunity No" value="{!OppoNumber}"/>
<apex:outputText label="Opportunity Type" value="{!OppoType }"/>
<apex:outputText label="Opportunity Source" value="{!OppoSource}"/>  --> 
            </apex:pageBlockSection>
            <apex:pageBlockSection title="CCAddress and Comments" collapsible="false" columns="1">
                <apex:inputtext label="TOAddresses" value="{!toaddr}" size="70"/>
                <apex:inputtext label="CCAddresses" value="{!ccaddr}" size="70"/>
                <apex:inputtextarea value="{!comment}" label="Comments/Note" /> 
            </apex:pageBlockSection>
            
            <!------------------------------for other information-------------->
            
            
            <apex:pageBlockSection title="Other information" collapsible="false">
                
                <!-- 1. Disposition -->
                <apex:selectList value="{!dispo}" size="1" label="Disposition">
                    <apex:selectOption itemValue="" itemLabel=""/>
                    <apex:selectOption itemValue="MQL(Intent)" itemLabel="MQL(Intent)"/>
                    <apex:selectOption itemValue="SQL/High Intent" itemLabel="SQL/High Intent"/>
                </apex:selectList>
                
                <!-- 2. Currently Hiring? -->
                <apex:selectList value="{!currentlyHiring}" size="1" label="Currently Hiring?">
                    <apex:selectOption itemValue="" itemLabel=""/>
                    <apex:selectOption itemValue="Yes" itemLabel="Yes"/>
                    <apex:selectOption itemValue="No" itemLabel="No"/>
                </apex:selectList>
                
                <!-- 3. Number of Open Positions/Roles (No Change mentioned - assuming existing field if any) -->
                <!-- If separate property exists, keep it. Otherwise remove this block -->
               <!-- <apex:inputText value="{!openPositions}" label="Number of Open Positions/Roles" /> -->
                
                <!-- 4. How many positions to close -->
                <apex:inputText value="{!numPositions}" label="How many positions to close" />
                
                <apex:inputText value="{!rolesToClose}" label="What roles are you planning to close" />
                
                <!-- 5. Decision Maker or Influencer or others -->
                <apex:selectList value="{!auth}" size="1" label="Decision Maker or Influencer or others">
                    <apex:selectOption itemValue="" itemLabel=""/>
                    <apex:selectOption itemValue="Decision Maker" itemLabel="Decision Maker"/>
                    <apex:selectOption itemValue="Influencer" itemLabel="Influencer"/>
                    <apex:selectOption itemValue="Others Involved in Hiring" itemLabel="Others Involved in Hiring"/>
                </apex:selectList>
                
                <!-- 6. Designation / Job Title -->
                <apex:inputText value="{!designation}" label="Designation / Job Title" />
                
                <!-- 7. Decision maker from same location or Different -->
                <apex:inputText value="{!decisionMakerLoc}" label="Decision maker from same location or Different" />
                
                <!-- 8. Timeline to close the requirements -->
                <apex:selectList value="{!tym}" size="1" label="Timeline to close the requirements">
                    <apex:selectOption itemValue="" itemLabel=""/>
                    <apex:selectOption itemValue="Immediately/within 2 days" itemLabel="Immediately/within 2 days"/>
                    <apex:selectOption itemValue="Within a week" itemLabel="Within a week"/>
                    <apex:selectOption itemValue="Within 2 weeks" itemLabel="Within 2 weeks"/>
                    <apex:selectOption itemValue="Within a month" itemLabel="Within a month"/>
                    <apex:selectOption itemValue="More than a month" itemLabel="More than a month"/>
                </apex:selectList>
                
                <!-- 9. Budget allocated for recruitment tools -->
                <apex:inputtextarea label="Budget allocated for recruitment tools" value="{!bud}"/>
                
                <!-- 10. Existing Job Portals in Use -->
                <apex:inputText value="{!existingPortals}" label="Existing Job Portals in Use" />
                
                <!-- 11. Posting on Competitor Sites -->
                <apex:inputText value="{!competitorPosting}" label="Posting on Competitor Sites" />
                
                <!-- 12. Demo/Initial date & time -->
                <apex:input value="{!demoDateTime}" label="Demo/Initial date & time" type="datetime-local" />
                
                <!-- 13. Lead Potential -->
                <apex:selectList value="{!poten}" size="1" label="Lead Potential">
                    <apex:selectOption itemValue="" itemLabel=""/>
                    <apex:selectOption itemValue="High" itemLabel="High"/>
                    <apex:selectOption itemValue="Medium" itemLabel="Medium"/>
                    <apex:selectOption itemValue="Low" itemLabel="Low"/>
                </apex:selectList>
                
                <apex:inputText value="{!basicServices}" label="Basic Services Or Other" />
                
            </apex:pageBlockSection>
            
            
            <!-----------------------------for attachments---------------------------------------->
            <apex:pageblockSection title="Attachment file Section" collapsible="false">
                <apex:inputfile fileName="{!attname}" value="{!attbody}">
                </apex:inputfile>
            </apex:pageblocksection>
            
        </apex:pageBlock>
        
    </apex:form>
</apex:page>