<apex:page standardController="Account" tabStyle="Account" extensions="Account_create" lightningStylesheets="true">
    <script>
        function func() {

            // alert('function call');
            var d = '{!g}';
            // alert(d);
            this.parent.location.href = d;
        }



    </script>

    <apex:outputText value="{!callfunc}" escape="false"></apex:outputText>

    <apex:pagemessages />


    <apex:form >
        <!--@ jo to list existing list of similar account-->
        <!--Not B2CProfile -->
        <apex:outputPanel rendered="{!IF($User.ProfileId !='00e7F000000uSSeQAM',true,false)}">
            <apex:pageBlock rendered="{!if(existing.size>0,true,false)}" title="Existing Accounts Found">

                <apex:pageblockButtons >
                    <apex:commandButton value="Merge And Save" action="{!merge_acc}" rendered="{!show_button}" />
                    <apex:commandButton value="Save And Ignore" action="{!save_ignore}" rendered="{!showSaveButton}" />

                </apex:pageblockButtons>
                <apex:pageblockTable value="{!existing}" var="j">
                    <apex:column >
                        <apex:inputcheckbox value="{!j.b}" rendered="{!show_button}" />
                    </apex:column>

                    <apex:column value="{!j.j.name}" />
                    <apex:column value="{!j.j.phone}" />
                    <apex:column value="{!j.j.website}" />
                    <apex:column value="{!j.j.Account_Sharing_Date__c}" />
                </apex:pageblockTable>
            </apex:pageBlock>
        </apex:outputPanel>
        <apex:outputPanel rendered="{!IF($User.ProfileId =='00e7F000000uSSeQAM',true,false)}">
            <apex:pageBlock rendered="{!if(existing.size>0,true,false)}" title="Existing Accounts Found Please work on below lead">
                <apex:pageblockTable value="{!existing}" var="j">

                    <apex:column headerValue="Name">
                        <apex:outputLink value="/{!j.j.id}" target="_blank">{!j.j.Name}</apex:outputLink>
                    </apex:column>
                    <apex:column value="{!j.j.Mobile__c}" />
                    <apex:column value="{!j.j.Email__c}" />
                </apex:pageblockTable>
            </apex:pageBlock>
        </apex:outputPanel>


        <apex:outputPanel rendered="{!IF($User.ProfileId == '00eC5000000LvTpIAK',true,false)}">
            <apex:sectionHeader title="New Account" subtitle="Account Edit" />
            <apex:pageBlock title="Account Read">

                <apex:pageblockButtons >

                    <apex:commandButton value="save" action="{!save_custom}" />
                    <apex:commandButton value="cancel" action="{!cancel}" />

                </apex:pageblockButtons>

                <apex:pageBlockSection title="Accounts Details" columns="2" collapsible="false">

                    <apex:inputField value="{!Account.name}" />
                    <apex:inputField value="{!Account.SalesChannel__c}" required="true" />
                    <apex:inputField value="{!account.Phone}" />
                    <apex:inputfield value="{!account.OtherPhone__c}" />
                    <apex:inputField value="{!Account.Email__c}" /> 
                    <apex:inputField value="{!Account.Dispositions__c}" />

                </apex:pageBlockSection>

                <apex:pageBlockSection title="Customer Profile" columns="2" collapsible="false">

                    <apex:inputField value="{!Account.Gender__c}" required="true" />
                    <apex:inputField value="{!Account.City__c}" required="true" />
                    <apex:inputField value="{!Account.PA_State__c}" required="true" />
                    <apex:inputField value="{!Account.Seeker_Lead_Source1__c}" />
                    <apex:inputField value="{!Account.University_Dropdown__c}" required="true" />
                    <apex:inputField value="{!Account.Selling_Stream__c}" />
                    <apex:inputField value="{!Account.Seeker_Service__c}" required="true" />
                    <apex:inputField value="{!Account.Customer_Experience__c}" />

