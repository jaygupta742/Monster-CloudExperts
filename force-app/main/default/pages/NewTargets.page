<apex:page standardController="Target__c"  extensions="addtargets" lightningStylesheets="true">
<apex:form >
    
    <apex:pageBlock id="Re">
    <apex:pageMessages id="showmsg" escape="false"></apex:pageMessages>
        <apex:pageBlockButtons >
            <apex:commandButton value="Save" action="{!save}" reRender="Re"/>
            <apex:commandButton value="Add" action="{!addnew}" reRender="Re"/>
            <!--<apex:commandButton value="Copy" action="{!copy}" reRender="Re"/>-->
            <!--<apex:commandButton value="Delete" action="{!remove}" reRender="Re"/>-->
        </apex:pageBlockButtons>
        <apex:variable value="{!1}" var="cou"/>
        <apex:pageBlockTable value="{!lt}" var="t" width="100%">
            <apex:column headerValue="Sl.No" style="width:20px;">
                <apex:outputtext value="{!cou}" style="width:20px;"/>
            </apex:column>
            <!--<apex:column headerValue="Select" style="width:20px;">
                <apex:inputfield value="{!t.Select__c}" style="width:20px;"/>
            </apex:column>-->
             <apex:column headerValue="Remove" style="width:20px;">
                 <apex:commandButton value="Delete" action="{!remove}" reRender="Re">
                 <apex:param name="row" value="{!cou}" assignTo="{!rowtoremove}"  /></apex:commandButton>
             </apex:column>
             
            <apex:column headerValue="User" style="width:100px;">
                <apex:inputField value="{!t.User__c}" style="width:100px;"/>
            </apex:column>
            <apex:column headerValue="Start Date" style="width:100px;">
                <apex:inputField value="{!t.Start_Date__c}" style="width:100px;"/>
            </apex:column>
            <apex:column headerValue="End Date" style="width:100px;">
                <apex:inputField value="{!t.End_Date__c}" style="width:100px;"/>
            </apex:column>
            <!--<apex:column headerValue="Unique Account" style="width:60px;">
                <apex:inputField value="{!t.Unique_Account__c}" style="width:60px;"/>
            </apex:column>
            <apex:column headerValue="Demo" style="width:60px;">
                <apex:inputField value="{!t.Demonstration__c}" style="width:60px;"/>
            </apex:column>
            <apex:column headerValue="Free Trail" style="width:60px;">
                <apex:inputField value="{!t.Free_Trail__c}" style="width:60px;"/>
            </apex:column>
            <apex:column headerValue="Unique Oppor" style="width:60px;">
                <apex:inputField value="{!t.Unique_Opportunity__c}" style="width:60px;"/>
            </apex:column>
            <apex:column headerValue="OCT" style="width:60px;">
                <apex:inputField value="{!t.Opportunity_Created_Target__c}" style="width:60px;"/>
            </apex:column>
            <apex:column headerValue="OWT" style="width:60px;">
                <apex:inputField value="{!t.Opportunity_Won_Target__c}" style="width:60px;"/>
                <apex:variable value="{!cou+1}" var="cou"/>
            </apex:column>-->
            <apex:column headerValue="Revenue Target" style="width:100px;">
                <apex:inputField value="{!t.Opportunity_Won_Target__c}" style="width:100px;"/>
                <apex:variable value="{!cou+1}" var="cou"/>
            </apex:column>
        </apex:pageBlockTable>
    </apex:pageBlock>
</apex:form>
</apex:page>