<apex:page standardController="Contact" sidebar="false" showHeader="true"  extensions="Contacts_AddToCampaign_Page_Controller" lightningStylesheets="true"    recordSetVar="contact" >
	<apex:form style="width: 50%;margin-left: 25%;">
    
    <apex:outputPanel rendered="{!renderMe}" >
        
        <apex:includeLightning />
            <script>
                var compDefinition = { 
                "componentDef" : "c:createCampaign", 
                "attributes" :{ 
                      "contacts" : {!json_val}
                 } 
                };
        
            var encodedCompDef = btoa(JSON.stringify(compDefinition));
            window.parent.location = "/one/one.app#"+encodedCompDef;  
        </script> 
        </apex:outputPanel> 
 		<br/>
         <apex:outputPanel >
                <apex:pageMessages />
            </apex:outputPanel>
         <apex:commandButton action="{!Cancel}" value="Back" style="margin-left: 90%;font-weight: bold;"/>
        
    </apex:form>
    

</apex:page>