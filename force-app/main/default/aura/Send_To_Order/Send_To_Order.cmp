<aura:component implements="force:hasRecordId,force:lightningQuickActionWithoutHeader" controller="Send_to_Order">
	<aura:attribute name="recordId" type="Id"/>
    <aura:attribute name="profileId" type="boolean" default="true"/>
    <aura:attribute name="error" type="Boolean"/>
    <aura:attribute name="disabled" type="Boolean"/>
    <aura:attribute name="message" type="String" default="Loading..."/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/> 
    <div class="modal-header slds-modal__header slds-size_1-of-1">
        <h4 class="title slds-text-heading--medium" >Send To Order</h4>
    </div>
    <div class="slds-scrollable slds-p-around_medium slds-text-heading_small" id="modal-content-id-1">
        <p style="height: 108px; word-wrap: break-word;">{!v.message}</p>
        
        <br/>
    </div>
	<div class="slds-modal__footer">
      <lightning:button class="slds-button_brand" onclick="{!c.createOrder}" label="Create Order" disabled="{!v.profileId || v.error || v.disabled}"/>
        <lightning:button class="slds-button_brand" onclick="{!c.accept}" label="Accept" disabled="{!not(v.profileId)}"/>
    </div>
    <aura:html tag="style">
            .cuf-content {
                padding: 0 0rem !important;
            }
            .slds-p-around--medium {
                padding: 0rem !important;
            }       
            .slds-modal__content{
                overflow-y:hidden !important;
                height:unset !important;
                max-height:unset !important;
            }
    </aura:html>
</aura:component>