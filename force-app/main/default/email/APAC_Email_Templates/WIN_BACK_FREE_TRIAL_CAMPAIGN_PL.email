<![CDATA[<p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font size="2"><font face="Verdana"><strong>Send Email to -</strong>&nbsp;<font size="2">MO-IN-CSR</font></font></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font size="2"><br></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2">Hi,</font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2"><br></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2">Please find attached the free trial request for<br></font><font face="Verdana" size="2"><strong></strong></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2"><br></font></p><p style=""><strong style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;">Pending Lead Name -</strong><font face="Verdana" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">&nbsp;</font><font face="Verdana" size="2" style="color: rgb(0, 0, 0);">&nbsp;</font><span style="line-height: 15.3333px;"><font face="Verdana" size="2">{!Opportunity.Account}</font><br><strong style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;">Pending Lead ID -</strong><font face="Verdana, sans-serif" style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><span style="font-size: 10pt;">&nbsp;&nbsp;</span></font><font face="arial"><span style="font-size: 13.3333px;">{!Opportunity.Id}</span></font><br><strong style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;">Pending Lead Sales Channel -</strong><font face="Verdana, sans-serif" style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><span style="font-size: 10pt;">&nbsp;{!Account.SalesChannel__c}&nbsp;</span></font><br><strong style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;">Pending Lead&nbsp;Sales Rep -</strong><strong style="color: rgb(0, 0, 0); font-size: 10pt;"><font face="Verdana">&nbsp;</font></strong></span><font face="Verdana"><span style="font-size: 13.3333px;">{!Opportunity.OwnerFullName}</span></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2"><span style="font-size: 10pt; line-height: 15.3333px; font-family: Verdana, sans-serif;"><br></span></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2"><span style="font-size: 10pt; line-height: 15.3333px; font-family: Verdana, sans-serif;"></span></font><font face="Verdana" size="2">This has also been approved by my manager, enclosed is the email.</font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2"><br></font></p><p style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;"><font face="Verdana" size="2">Regards,<br>&lt;Enter Signature&gt;</font></p>]]></td>
