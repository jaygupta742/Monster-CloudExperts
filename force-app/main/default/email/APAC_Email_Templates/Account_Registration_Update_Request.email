<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: normal;"><font size="2" face="Verdana, Helvetica, sans-serif">Send Email To:&nbsp;&nbsp;<br></font></p><table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="680" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: auto auto auto 4.75pt; width: 510pt; border-collapse: collapse;"><tbody><tr style="height: 15pt;"><td valign="bottom" width="680" nowrap="" style="border: rgb(236, 233, 216); padding: 0in 5.4pt; width: 510pt; height: 15pt;"><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><font face="Verdana, Helvetica, sans-serif" size="2"><u>India Telesales ACQ Users</u>&nbsp; -&nbsp;MO-IN-SF Request TS ACQ (SFrequesttsacq@monsterindia.com)</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;</span></p><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><u style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">India Telesales RET Users</u><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp; -&nbsp;</span><font face="Verdana, Helvetica, sans-serif" size="2">MO-IN-SF Request Retention (SFrequestretenstion@monsterindia.com)</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;</span></p><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><font face="Verdana, Helvetica, sans-serif" size="2"><u>India Fieldsales Users</u>&nbsp;&nbsp;-&nbsp;MO-IN-SF Request Fieldsales (SFrequestfieldsales@monsterindia.com)</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;</span></p></td></tr><tr style="height: 15pt;"><td valign="bottom" width="680" nowrap="" style="border: rgb(236, 233, 216); padding: 0in 5.4pt; width: 510pt; height: 15pt;"><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><font face="Verdana, Helvetica, sans-serif" size="2"><u>Gulf Users</u>&nbsp; -&nbsp;MO-ME SF Request (MESFrequest@monstergulf.com)</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;</span></p></td></tr><tr style="height: 15pt;"><td valign="bottom" width="680" nowrap="" style="border: rgb(236, 233, 216); padding: 0in 5.4pt; width: 510pt; height: 15pt;"><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><font face="Verdana, Helvetica, sans-serif" size="2"><u>SEA Users</u>&nbsp; -&nbsp;MO-SEA SF Request (SEASFrequest@monster.com.sg)</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;</span></p></td></tr></tbody></table><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif"><u></u><br></font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">To ensure that your request is processed correctly, please&nbsp;</span><u style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">DO NOT</u><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">&nbsp;change the subject line of this message</span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif"><br>Please do not delete any fields when filling out template.</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif"><br></font></p><p style=""><span style="color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: 12pt;">Account ID -&nbsp;</span><font face="Calibri"><b>{!Account.AccountID__c}</b></font></p><p style=""><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Account Name - {!Account.Name}<br></font><span style="color: rgb(0, 0, 0); font-family: Verdana, Helvetica, sans-serif; font-size: small;">Current Sales Rep Login -&nbsp;</span><font face="Calibri">{!Account.OwnerLastName}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: Calibri, sans-serif; font-size: 12pt;">Current Registration# -&nbsp;</span><font face="Calibri, sans-serif">{!Account.RegistrationNumber__c}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt; font-family: Calibri, sans-serif;"><br></span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 12pt; font-family: Calibri, sans-serif;"><b>Change/Update Registration# to:</b>&nbsp;<br></span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: Calibri, sans-serif;">Comments: &nbsp;<o:p></o:p></span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: Calibri, sans-serif;"><br></span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: Calibri, sans-serif;"><br></span></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><strong><u><span style="font-family: Calibri, sans-serif; color: rgb(51, 102, 204);">*Supporting Documents required: Registration Number reflecting in the registered legal entity OR Registration of Company certificate (ROC).</span></u></strong><o:p></o:p></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><br><span style="font-family: Calibri, sans-serif; color: rgb(255, 0, 102);">Any Exceptions apart from the above needs to be approved by Managing Director.</span></p>]]></td>
