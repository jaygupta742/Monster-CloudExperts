_Proposal__Proposal__c.BillingCountry__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Payment type:&nbsp;</font><span style="font-family: Calibri;">{!Apttus_Proposal__Proposal__c.PaymentDetails__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri"></font>&nbsp;</p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Sales Notes:</font></p>]]></td>
