<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<o:p style="font-family: arial; font-size: 12pt;"><p class="MsoNormal" style="margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: medium;">Please email your request to:&nbsp;</span><span style="background-color: rgb(255, 255, 255);"><font face="Calibri, sans-serif" style=""><u style="">apac-creditcheck@</u></font><span style="font-family: Calibri, sans-serif; font-size: 14.6667px;">Monsterindia.com</span></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); margin: 0in 0in 0pt; font-size: medium;"><span style="font-family: Calibri, sans-serif;"><u><span style="color: red;"></span></u><span style="color: red;"><o:p></o:p></span></span>&nbsp;</p></o:p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: medium; margin: 0in 0in 0pt;"><font face="Times New Roman">Credit Risk Team, please check the below:<o:p></o:p></font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri"></font><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); margin: 0in 0in 0pt;"><font face="Calibri" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;">Quote #:&nbsp;</font><font face="Verdana" size="2">{!apttus_proposal_proposal__c.Name}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Quote Amount:&nbsp;</font><span style="font-family: Calibri;">{!Apttus_Proposal__Proposal__c.Apttus_Proposal__Amount__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Quote Sales rep:&nbsp;</font><span style="font-family: Verdana; font-size: small; background-color: rgb(255, 255, 255);">{!Apttus_Proposal__Proposal__c.OwnerFullName}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri"></font></o:p>&nbsp;</p><p class="MsoNormal" style="color: rgb(0, 0, 0); margin: 0in 0in 0pt;"><font face="Calibri" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;">Posting Account ID:&nbsp;</font><font face="Verdana" size="2">{!apttus_proposal_proposal__c.AccountId__c}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Posting Account Name:&nbsp;</font><span style="font-family: Calibri;">{!Apttus_Proposal__Proposal__c.Apttus_Proposal__Account__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Posting Company Reg #:&nbsp;</font><span style="font-family: Calibri;">{!Apttus_Proposal__Proposal__c.CompanyRegistrationNumber__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); margin: 0in 0in 0pt;"><font face="Calibri" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;">Local Agency Account Name:&nbsp;</font><font face="Calibri">{!apttus_proposal_proposal__c.Agency__c}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri"><br></font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); margin: 0in 0in 0pt;"><font face="Calibri" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;">Local Agency Account ID :&nbsp;</font><font face="Calibri">{!apttus_proposal_proposal__c.Local_Agency_Cust__c}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Current Credit Limit:&nbsp;</font><span style="font-family: Verdana; font-size: small; background-color: rgb(255, 255, 255);">{!Apttus_Proposal__Proposal__c.Credit_limit__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Payment Terms:&nbsp;</font><span style="font-family: Calibri;">{!Apttus_Proposal__Proposal__c.Apttus_Proposal__Payment_Term__c}</span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot