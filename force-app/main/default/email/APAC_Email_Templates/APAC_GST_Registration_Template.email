<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u style="font-family: arial; font-size: 12pt;">India Telesales ACQ Users</u><font face="arial"><span style="font-size: 12pt;">&nbsp;-&nbsp;</span></font></font><span style="color: rgb(31, 73, 125); font-family: Calibri, sans-serif; font-size: 14.6667px; background-color: rgb(255, 255, 255);">MO-IN-SF Request TS ACQ (</span><a href="mailto:SFrequesttsacq@monsterindia.com" target="_blank" style="color: rgb(17, 85, 204); font-family: Calibri, sans-serif; font-size: 14.6667px; background-color: rgb(255, 255, 255);">SFrequesttsacq@monsterindia.<wbr>com</a><span style="color: rgb(31, 73, 125); font-family: Calibri, sans-serif; font-size: 14.6667px; background-color: rgb(255, 255, 255);">)</span></div><div style=""><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u style="font-family: arial; font-size: 12pt;">India Telesales RET Users</u><font face="arial"><span style="font-size: 12pt;">&nbsp;-&nbsp;</span></font></font><font face="arial">MO-IN-SF Request Retention (SFrequestretenstion@monsterindia.com)</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u style="font-family: arial; font-size: 12pt;">India Fieldsales Users</u><font face="arial"><span style="font-size: 12pt;">&nbsp;-&nbsp;</span></font></font><span style="font-size: 12pt;">MO-IN-SF Request Fieldsales (SFrequestfieldsales@monsterindia.com)</span></div><div><span style="font-size: 12pt;"><br></span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">To ensure that your request is processed correctly, please DO NOT change the subject line of this message. Please do not delete any fields when filling out template.&nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Account ID - {!Account.AccountID__c}&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Account Name - {!Account.Name}&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2" style=""><font face="arial"><span style="font-size: 12pt;">Current Sales Rep Login - </span></font>{!Account.OwnerFullName}<font face="arial"><span style="font-size: 12pt;">&nbsp;</span></font></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Change/Update GST Registration#</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">{!Account.VATNumber__c}&nbsp;</span><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">to: &nbsp;</span></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Comments:&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">*Supporting Documents required: (if REGISTERED) GST Registration Certificate Else (UNREGISTERED) Signed declaration from Client.&nbsp;</font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></div><div style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Any Exceptions for the above needs to be approved by Managing Director, APAC Region.&nbsp;</font></div>]]></td>
</tr>
