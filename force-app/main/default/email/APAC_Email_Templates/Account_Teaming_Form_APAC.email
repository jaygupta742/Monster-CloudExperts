<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><span lang="EN"><font size="2" face="Verdana">To ensure that your request is processed correctly, please DO NOT change the subject line of this message. Sales reps should submit this template to their manager. Manager should forward approved requests to the below</font></span><span lang="EN"><font size="2" face="Verdana">&nbsp;mailbox.</font></span></p><span lang="EN" style=""><p class="MsoNormal" style="font-family: arial; margin: 0in 0in 0pt;"><font style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><u><span style="font-size: 12pt;">India Telesales ACQ Users</span></u><span style="font-size: 12pt;">&nbsp; -&nbsp;</span></font><a href="mailto:SFrequesttsacq@monsterindia.com" target="_blank" style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);"><font color="#333333">SFrequesttsacq@monsterindia.<wbr>com</font></a></p><p class="MsoNormal" style="font-family: arial; margin: 0in 0in 0pt;"><font style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><u><span style="font-size: 12pt;">India Telesales RET Users</span></u><span style="font-size: 12pt;">&nbsp; -&nbsp;</span></font><a href="mailto:SFrequestretenstion@monsterindia.com" target="_blank" style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);"><font color="#333333">SFrequestretenstion@<wbr>monsterindia.com</font></a></p><p class="MsoNormal" style="font-family: arial; margin: 0in 0in 0pt;"><font style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-size: 12pt;"></span></font><u style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-family: Calibri, sans-serif; font-size: 12pt;">India Fieldsales Users</span></u><span style="color: rgb(0, 0, 0); font-size: 12pt; font-family: Calibri, sans-serif;">&nbsp;&nbsp;-&nbsp;</span><a href="mailto:SFrequestfieldsales@monsterindia.com" target="_blank" style="font-family: Arial, Helvetica, sans-serif; background-color: rgb(255, 255, 255);"><font color="#333333">SFrequestfieldsales@<wbr>monsterindia.com</font></a></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-size: 12pt; margin: 0in 0in 0pt;"><font face="Calibri"><br></font><br><font face="arial" style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><span style="font-size: 12pt;">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -</span></font><br><font face="arial" style="font-family: arial; color: rgb(0, 0, 0); font-size: 12pt;"><span style="font-size: 12pt;">Account ID:&nbsp;</span></font><font face="arial" style="font-family: arial;">{!Opportunity__c.Opp_AccountID__c}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial; margin: 0in 0in 0pt;"><br>Account Name:&nbsp;{!Opportunity__c.Account__c}</p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial; margin: 0in 0in 0pt;"><br></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial; margin: 0in 0in 0pt;"><font style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Oppty ID:&nbsp;</font><font face="Verdana" size="2">{!Opportunity__c.Name}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial; margin: 0in 0in 0pt;"><span style="font-family: Verdana; font-size: small;"><br></span></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font size="2" face="Verdana"><font style="font-family: arial; font-size: 12pt;">Oppty Primary Rep:&nbsp;</font></font><font face="arial" style="font-size: 12pt;"><span style="font-size: 12pt;">{!Opportunity.OwnerFullName}</span></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><span style="color: rgb(0, 0, 0); font-family: Verdana; font-size: small;">Primary Sales Channel:&nbsp;</span><font face="Verdana" size="2">{!Opportunity__c.Sales_Channel__c}</font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;">Account Status:&nbsp;<font face="Verdana" size="2">{!Opportunity__c.Account_Status__c}</font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;">Expected Sales Amount:&nbsp;<font face="Verdana" size="2">{!Opportunity__c.Expected_Revenue__c}</font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;">Est. Close Date:&nbsp;<font face="Verdana" size="2">{!Opportunity__c.Close_Date__c}</font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2" face="Verdana"><br></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: 12pt; font-family: arial;"><font size="2" face="Verdana" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium;">Forecasted:&nbsp;</font><font face="Verdana" size="2">{!Opportunity.ForecastCategoryName}</font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana"><br></font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana">Oppty Secondary Rep:&nbsp;<font color="#0000ff"><font color="#0000ff"><font color="#0000ff">(Please fill this field)</font></font></font></font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><br></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><br><font size="2"><font face="Verdana">Type of Teaming:&nbsp;<font color="#0000ff"><font color="#0000ff"><font color="#0000ff">(Please select from the following options or enter Other)</font></font></font></font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><br></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><br><font size="2"><font face="Verdana">___ Intra Channel</font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana"><br></font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana">___ Inter Channel - Two SMB Channels</font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana"><br></font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana">___ SMB and KA</font></font></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="2"><font face="Verdana"><br></font></font></p><font style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><p dir="ltr" align="left">___ Other: ______________________</p><p dir="ltr" align="left"><br></p></font><b style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><i><font color="#1f497d"><font color="#1f497d"><font color="#1f497d"><p dir="ltr" align="left"><font size="2" face="Verdana"></font></p><p dir="ltr" align="left"><font color="#000000" size="2" face="Verdana">Primary Rep share/split (%):</font></p><p dir="ltr" align="left"><font color="#000000" size="2" face="Verdana"><br></font></p><p dir="ltr" align="left"><font color="#000000" size="2" face="Verdana">Secondary Rep share/split (%):</font></p><p dir="ltr" align="left"><font color="#000000" size="2" face="Verdana"><br></font></p><p dir="ltr" align="left"><font color="#000000" size="2" face="Verdana"></font></p></font></font></font></i></b><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><b><font size="3"><font size="3"><font size="3"><font size="2" face="Verdana">Reason for Team up:</font></font></font></font></b></p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><b><font size="3"><font size="3"><font size="3"><font size="2" face="Verdana"><br></font></font></font></font></b></p><font size="3" style="color: rgb(0, 0, 0); font-size: medium; font-family: &quot;Times New Roman&quot;;"><font size="3"><font size="3"><p dir="ltr" align="left"><font size="2" face="Verdana"></font></p><p dir="ltr" align="left"><font size="2" face="Verdana">Prerequisites as attachments:</font></p><ol dir="ltr"><li><div align="left"><font size="2" face="Verdana">Both business heads approval emails mentioning Account Name, Account ID and percentage share.</font></div></li></ol><p><font size="2" face="Verdana"></font></p><p dir="ltr" align="left"><font size="2" face="Verdana"></font></p><p dir="ltr" align="left"><font size="2" face="Verdana">Note:</font></p><p dir="ltr" align="left"><font size="2" face="Verdana"><br></font></p><p dir="ltr" align="left"><font size="2" face="Verdana">Team up will be valid for 30 days only, post which accounts will be de-team up.</font></p></font></font></font></span>]]></td>
