<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><span style="font-family: Verdana, sans-serif;"><font face="Calibri">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -<br><o:p></o:p></font></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;"><font face="Calibri">To ensure that your request is processed correctly, please DO NOT change the subject line of this message. Sales reps should submit this template to the Ecomm Team.&nbsp;</font></span><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;"><br><font face="Calibri">- - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - - -<br><br>Karma Account ID: &nbsp;{!Account.AccountID__c}<br><br>Karma Account Name:&nbsp;<o:p></o:p></font></span><font face="Calibri">{!Opportunity.Account}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><span style="font-family: Verdana, sans-serif;"><o:p><font face="Calibri">&nbsp;</font></o:p></span></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;"><font face="Calibri">Oppty ID:&nbsp;</font></span><font face="Calibri">{!Opportunity.Id}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: &quot;Times New Roman&quot;; font-size: medium; margin: 0in 0in 0pt;"><span style="font-family: Verdana, sans-serif;"><font face="Calibri"><br></font></span></p><font face="Calibri" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span lang="EN" style=""><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;">Status: {!Opportunity.Status__c}</p><p dir="ltr" align="left" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;"><br></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;">Created Date:&nbsp;{!Opportunity.CreatedDate}<br><br>Oppty Primary Rep:&nbsp;{!Opportunity.OwnerFirstName}&nbsp;</p><p class="MsoNormal" style="margin: 0in 0in 0pt;">{!Opportunity.OwnerLastName}</p></span></font><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;"><br></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Oppty Primary Rep Manager: {!Opportunity.PrimaryRepManager__c}</font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;"><font face="Calibri">Primary Sales Channel: {!Account.SalesChannel__c}<o:p></o:p></font></p><p class="MsoNormal" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium; margin: 0in 0in 0pt;"><o:p><font face="Calibri">&nbsp;</font></o:p></p><p class="MsoNormal" style="margin: 0in 0in 0pt;"><font face="Calibri" style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: medium;">Comments:&nbsp;</font><font face="Calibri">{!Opportunity.Description}</font></p>]]></td>
