<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p style="margin: 0in 0in 0pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-family: Calibri, sans-serif; font-size: 11pt;">Hi,<o:p></o:p></span></p><p style="margin: 0in 0in 0pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-family: Calibri, sans-serif; font-size: 11pt;">&nbsp;</span></p><p style="margin: 0in 0in 0pt;"><span style="font-family: Calibri, sans-serif; font-size: 11pt;">SEND THIS EMAIL TO&nbsp;<o:p></o:p></span><font face="Calibri, sans-serif"><span style="font-size: 14.6667px;">activation@monsterindia.com</span></font></p><p style="margin: 0in 0in 0pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-family: Calibri, sans-serif; font-size: 11pt;">&nbsp;</span></p><p style="margin: 0in 0in 12pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><span style="font-family: Calibri, sans-serif; font-size: 11pt;">Please activate the Complimentary Services. Also, I am attaching Business Head approval email.<br><br><b>Quote Number</b>&nbsp;- {!Apttus_Proposal__Proposal__c.Name}</span><strong><span style="color: rgb(31, 73, 125);"><br></span></strong><strong><span style="font-family: Calibri, sans-serif; font-size: 11pt;">Account Name</span></strong><span style="font-family: Calibri, sans-serif; font-size: 11pt;">&nbsp;-&nbsp;</span><span style="font-family: Calibri, sans-serif; font-size: 15px;">{!Apttus_Proposal__Proposal__c.Apttus_Proposal__Account__c}</span><span style="font-family: Verdana, sans-serif; font-size: 10pt;"><br></span><strong><span style="font-family: Calibri, sans-serif; font-size: 11pt;">Sales Channel</span></strong><span style="font-family: Calibri, sans-serif; font-size: 11pt;">&nbsp;-&nbsp;</span><span style="font-family: Calibri, sans-serif; font-size: 15px;">{!Apttus_Proposal__Proposal__c.Sales_Channel__c}</span><span style="font-family: Calibri, sans-serif; font-size: 11pt;"><br><strong>Account Sales Rep</strong>&nbsp;-&nbsp;</span><span style="font-family: Calibri, sans-serif; font-size: 15px;">{!Apttus_Proposal__Proposal__c.OwnerFullName}</span></p><p class="MsoNormal" style="margin: 0in 0in 0pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><o:p>&nbsp;</o:p></p><p class="MsoPlainText" style="margin: 0in 0in 0pt; font-size: medium; font-family: &quot;Times New Roman&quot;;"><b><span style="font-family: Calibri, sans-serif; font-size: 11pt;">Customer&nbsp;Contact Information:&nbsp;</span></b><span style="font-family: Calibri, sans-serif; font-size: 11pt;"><br>Name -&nbsp;</span><font size="3"><font face="Consolas">{!Contact.FirstName} {!Contact.LastName} &nbsp;&nbsp;</font></font><span style="font-family: Calibri, sans-serif; font-size: 11pt;"><br>Email -&nbsp;</span><font size="3" face="Consolas">{!Contact.AlternateEmail__c}</font><span style="font-family: Calibri, sans-serif; font-size: 11pt;"><br>Phone -&nbsp;</span><font size="3"><font face="Consolas">{!Contact.PrimaryPhoneNumber__c}</font></font></p>]]></td>
