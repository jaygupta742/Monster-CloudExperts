<![CDATA[<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="font-family: Verdana, sans-serif; font-size: 10pt;">send Email to:&nbsp;</span><font face="Verdana, sans-serif"><span style="font-size: 13.3333px;">activation@monsterindia.com</span></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;">&nbsp;</span><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;">Please activate the services.<br><br><strong>Earliest Product Start Date</strong>&nbsp;-&nbsp;</span><font face="Verdana, sans-serif"><span style="font-size: 13.3333px;">{!OrderC__c.EarliestProductStartDate__c}</span></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><strong style="color: rgb(0, 0, 0); font-family: Calibri, sans-serif; font-size: 15px;"><span style="font-family: Verdana, sans-serif;">Account Name</span></strong><font face="Calibri, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><span style="font-size: 15px;">&nbsp;-&nbsp;</span></font><font face="Calibri, sans-serif"><span style="font-size: 15px;">{!OrderC__c.Account__c}</span></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;"><strong>Account ID&nbsp;</strong>-&nbsp;</span><font face="Verdana, sans-serif"><span style="font-size: 13.3333px;">{!OrderC__c.Account_ID__c}</span></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: 0in 0in 0pt;"><span style="color: rgb(0, 0, 0); font-family: Verdana, sans-serif; font-size: 10pt;"><strong>Order&nbsp;Number</strong>&nbsp;-&nbsp;</span><font face="Verdana, sans-serif"><span style="font-size: 13.3333px;">{!OrderC__c.Name}</span></font></p><p sty