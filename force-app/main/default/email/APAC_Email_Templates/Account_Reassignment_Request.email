<td tEditID="c1r1" style=" background-color:#FFFFFF; color:#000000; bEditID:r3st1; bLabel:main; font-size:12pt; font-family:arial;" aEditID="c1r1" locked="0" >
<![CDATA[<p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; line-height: normal;"><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">Send Email To: &nbsp;</span></p><table class="MsoNormalTable" border="0" cellspacing="0" cellpadding="0" width="680" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt; margin: auto auto auto 4.75pt; width: 510pt; border-collapse: collapse;"><tbody><tr style="height: 15pt;"><td valign="bottom" width="680" nowrap="" style="border: rgb(236, 233, 216); padding: 0in 5.4pt; width: 510pt; height: 15pt;"><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"></p></td></tr><tr style="height: 15pt;"><td valign="bottom" width="680" nowrap="" style="border: rgb(236, 233, 216); padding: 0in 5.4pt; width: 510pt; height: 15pt;"><p class="MsoNormal" style="margin-right: 0px; margin-left: 0px; color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; background-color: rgb(255, 255, 255);"><span style="font-size: 10pt; font-family: Verdana, sans-serif; color: black;">India &amp; Gulf Telesales&nbsp; &nbsp; -&nbsp;</span><span style="font-size: 10pt; font-family: Arial, sans-serif; color: black; background-image: initial; background-position: initial; background-size: initial; background-repeat: initial; background-attachment: initial; background-origin: initial; background-clip: initial;">MO-IN-TS-Reassignments</span><b><span style="font-size: 10pt; font-family: Verdana, sans-serif; color: black;">&nbsp;(</span></b><a href="mailto:tsreassignments@foundit.in" style="font-family: arial; font-size: 12pt;">tsreassignments@foundit.in</a><b><span style="font-size: 10pt; font-family: Verdana, sans-serif; color: black;">)&nbsp;</span></b></p><p class="MsoNormal" style="margin-right: 0px; margin-left: 0px; color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small; background-color: rgb(255, 255, 255);"><span style="font-size: 10pt; font-family: Verdana, sans-serif; color: black;">India &amp; Gulf Fieldsales&nbsp; &nbsp;-&nbsp;MO-IN-FS Reassignments<b>&nbsp;&nbsp;(</b></span><a href="mailto:fsreassignments@foundit.in" style="font-family: arial; font-size: 12pt;">fsreassignments@foundit.in</a><b><span style="font-size: 10pt; font-family: Verdana, sans-serif; color: black;">)&nbsp;</span></b></p><p class="MsoNormal" style="margin: 0in 0in 0pt; line-height: normal;"><span style="color: rgb(34, 34, 34); font-family: Arial, Helvetica, sans-serif; font-size: small;"><span style="font-size: 10pt; font-family: Arial, sans-serif; color: black;">SEA Users&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp;-&nbsp;MO-SEA SF Request<b> (</b></span></span><a href="mailto:seasfrequest@foundit.sg" style="font-size: 12pt;">seasfrequest@foundit.sg</a><b style="font-family: Arial, sans-serif; font-size: 10pt;">)</b></p></td></tr></tbody></table><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><u></u><br>Subject: Account Reassignment Request<strong>&nbsp;</strong></font><font face="Verdana, Helvetica, sans-serif" size="2"><b>{!Account.AccountID__c}</b></font><b style="color: rgb(0, 0, 0); font-family: Verdana, Helvetica, sans-serif; font-size: small;">: &nbsp;</b></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif">To ensure that your request is processed correctly, please&nbsp;<u>DO NOT</u>&nbsp;change the subject line of this message<br><br>Please do not delete any fields when filling out template.</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif"><br></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2" style=""><font face="arial"><span style="font-size: 12pt;">Please enter the following, all the fields are mandatory to process this request:</span></font><br><font face="arial"><span style="font-size: 12pt;">Account Name - {!Account.Name}</span></font><br><font face="arial"><span style="font-size: 12pt;">Account APAC Industry - </span></font>{!Account.APAC_Industry__c}<br><font face="arial"><span style="font-size: 12pt;">Account Employee Size -&nbsp;</span></font></font><font face="arial">{!Account.No_of_Employees__c}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Current Sales Rep Login -&nbsp;</font><font face="Verdana, Helvetica, sans-serif" size="2">{!Account.OwnerLastName}</font></p><p style=""><font face="Verdana, Helvetica, sans-serif" size="2" style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;">Current sales Rep Manager -&nbsp;</font><font face="Verdana, Helvetica, sans-serif" size="2">{!Account.PrimarySalesManager__c}</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif">Current Sales Channel and Segment - {!Account.SalesChannel__c} /&nbsp;</font><span style="font-family: Verdana, Helvetica, sans-serif; font-size: small;">{!Account.AccountGroup__c}</span><font size="2" face="Verdana, Helvetica, sans-serif"><br><br>New Sales Rep Login -&nbsp;</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font size="2" face="Verdana, Helvetica, sans-serif">New sales Rep Manager-&nbsp;<br>New Sales Channel -&nbsp;<br>New Account Segment -&nbsp;<br>My Foregoing Account -</font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2"><br></font></p><p style="color: rgb(0, 0, 0); font-family: arial; font-size: 12pt;"><font face="Verdana, Helvetica, sans-serif" size="2">Reason for Reassignment:</font></p>]]></td>
