<?xml version="1.0" encoding="UTF-8"?>
<Workflow xmlns="http://soap.sforce.com/2006/04/metadata">
    <alerts>
        <fullName>Notify_user</fullName>
        <description>Notify user</description>
        <protected>false</protected>
        <recipients>
            <field>SuppliedEmail__c</field>
            <type>email</type>
        </recipients>
        <senderAddress>cr@foundit.in</senderAddress>
        <senderType>OrgWideEmailAddress</senderType>
        <template>unfiled$public/Case_Notification</template>
    </alerts>
    <rules>
        <fullName>Case Notification</fullName>
        <actions>
            <name>Notify_user</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case__c.CreatedDate</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.Keyword_Search__c</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case__c.SuppliedEmail__c</field>
            <operation>notContain</operation>
            <value>@foundit</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
</Workflow>
