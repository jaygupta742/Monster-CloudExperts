<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>AccountStatus</fullName>
    <active>true</active>
    <errorConditionFormula>IF(NOT(Person_Account__c ),
IF( Case_Accounts__c == False,If(AND(ISNEW(),NOT(ISPICKVAL( Lead_Account_Status__c , &apos;Inactive&apos;) )),true,false),false)
			,false)</errorConditionFormula>
    <errorDisplayField>Lead_Account_Status__c</errorDisplayField>
    <errorMessage>You Cannot Change The Lead Account Status At This Level.</errorMessage>
</ValidationRule>
