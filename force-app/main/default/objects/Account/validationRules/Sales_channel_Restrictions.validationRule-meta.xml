<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Sales_channel_Restrictions</fullName>
    <active>false</active>
    <errorConditionFormula>AND( ISNEW() ,(AND( 
!ISPICKVAL(SalesChannel__c,&quot;Enterprise Business&quot;), 

!ISPICKVAL(SalesChannel__c,&quot;Telesales-India&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Fieldsales.me&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Fieldsales.sg&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;SMB Business&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Fieldsales.my&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Fieldsales.ph&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Telesales-ME&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Fieldsales.hk&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Telesales-SEA&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Media Works&quot; ), 

!ISPICKVAL(SalesChannel__c,&quot;Surplus&quot; ) 

)))</errorConditionFormula>
    <errorDisplayField>SalesChannel__c</errorDisplayField>
    <errorMessage>Please choose the values that are in picklist</errorMessage>
</ValidationRule>
