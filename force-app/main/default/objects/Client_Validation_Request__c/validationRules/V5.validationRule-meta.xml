<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>V5</fullName>
    <active>true</active>
    <errorConditionFormula>and(not(isblank(Passport_Number__c)),isblank(Passport_Name__c))</errorConditionFormula>
    <errorDisplayField>Passport_Name__c</errorDisplayField>
    <errorMessage>Enter Passport Name</errorMessage>
</ValidationRule>
