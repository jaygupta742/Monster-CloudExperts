<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_4</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 INCLUDES(  ID_Proof__c  ,&quot;Pan Card&quot;) ,
ISBLANK( PAN_Number__c ),isblank(PAN_Card_Name__c)
)</errorConditionFormula>
