<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Validation_5</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 INCLUDES( ID_Proof__c ,&quot;Passport&quot;) ,
ISBLANK(     Passport_Number__c   ),isblank(Passport_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Passport_Number__c</errorDisplayField>
    <errorMessage>Enter your Passport Number</errorMessage>
</ValidationRule>
