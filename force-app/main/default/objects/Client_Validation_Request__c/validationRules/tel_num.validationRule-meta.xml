<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>tel_num</fullName>
    <active>true</active>
    <errorConditionFormula>not(isnumber(Tel_Number__c)||LEN( Tel_Number__c ) &lt;&gt; 10)</errorConditionFormula>
    <errorDisplayField>Tel_Number__c</errorDisplayField>
    <errorMessage>Please enter correct Phone number</errorMessage>
</ValidationRule>
