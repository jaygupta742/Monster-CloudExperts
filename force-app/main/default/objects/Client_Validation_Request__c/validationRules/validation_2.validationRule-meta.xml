<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>validation_2</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
 INCLUDES( ID_Proof__c ,&quot;Election Card&quot;) ,
ISBLANK(  Voter_ID__c  ),isblank(Voter_ID_Name__c)
)</errorConditionFormula>
    <errorDisplayField>Voter_ID__c</errorDisplayField>
    <errorMessage>Enter your Voter ID number</errorMessage>
</ValidationRule>
