<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Restrict_Stage_Change_For_Lead</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISPICKVAL(Closure_probablity__c, &quot;Lead&quot;),
    ISPICKVAL(PRIORVALUE(Stage__c), &quot;Identification&quot;),
    NOT(ISNEW()),
    ISCHANGED(Stage__c)
)</errorConditionFormula>
    <errorMessage>You cannot change the stage from &apos;Identification&apos; when the Opportunity Closure Probability is &apos;Lead&apos;.</errorMessage>
</ValidationRule>
