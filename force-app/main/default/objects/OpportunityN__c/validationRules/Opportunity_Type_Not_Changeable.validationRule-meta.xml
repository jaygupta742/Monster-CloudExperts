<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Opportunity_Type_Not_Changeable</fullName>
    <active>false</active>
    <description>Opportunity Type is not changeable</description>
    <errorConditionFormula>NOT(ISNEW()) &amp;&amp; ISCHANGED( Opportunity_Type__c ) &amp;&amp; $Profile.Name  &lt;&gt; &apos;System Admin&apos;</errorConditionFormula>
    <errorDisplayField>Opportunity_Type__c</errorDisplayField>
    <errorMessage>Opportunity Type is not changeable. Please connect with admin.</errorMessage>
</ValidationRule>
