<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>OwnerShip_Change_Restrictions</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
ISCHANGED(OwnerId),
($User.Alias = &quot;SBabu&quot;||$User.Alias = &quot;YYaqub&quot;),
LEFT(Id,3) &lt;&gt; &quot;a0k&quot;
)</errorConditionFormula>
    <errorDisplayField>OwnerId</errorDisplayField>
    <errorMessage>You don&apos;t have access to change this ownership !!</errorMessage>
</ValidationRule>
