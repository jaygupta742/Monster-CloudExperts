<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Phone_and_Mobile_should_not_be_same</fullName>
    <active>false</active>
    <description>Phone and Mobile should not be same</description>
    <errorConditionFormula>if( !ISBLANK(MobilePhone), Phone == MobilePhone , false)</errorConditionFormula>
    <errorMessage>Phone And Mobile Cannot Be Same</errorMessage>
</ValidationRule>
