<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Check_Enrollment_Number_Before_Verify</fullName>
    <active>true</active>
    <errorConditionFormula>AND(NOT(ISPICKVAL( Order_Status__c ,&apos;Quote&apos;)), ISBLANK( Enrollment_No__c ))</errorConditionFormula>
    <errorMessage>Enrollment No Is Needed For Verification</errorMessage>
</ValidationRule>
