<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cant_Send_To_Order</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
Total_Payment__c  &lt;&gt;  Net_Total__c,
NOT(ISCHANGED(Net_Total__c))				
)</errorConditionFormula>
    <errorMessage>Total Payment Should Be Equal To Net Total</errorMessage>
</ValidationRule>
