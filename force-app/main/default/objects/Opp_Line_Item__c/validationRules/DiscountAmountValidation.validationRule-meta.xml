<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DiscountAmountValidation</fullName>
    <active>false</active>
    <description>Discount Amount Should not be more than Discount Cap Amount Validation</description>
    <errorConditionFormula>Total_Discount_Amount__c &gt; ( Product__r.Discount_Cap_Amount__c *  Quantity_Unit__c )</errorConditionFormula>
    <errorDisplayField>Discount_Value__c</errorDisplayField>
    <errorMessage>Discount Amount Exceeded Cap Amount</errorMessage>
</ValidationRule>
