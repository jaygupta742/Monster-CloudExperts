<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>FirstContactTimeframe__c</fullName>
    <description>The percent of time passed until SLA is met.</description>
    <formula>IF( text(FirstContactDate__c) =&quot;&quot;,Time_With_Support__c / FirstContactCommitment__c,null)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>Shows elapsed time as a % until First Contact is due.</inlineHelpText>
    <label>First Contact % Timeframe</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Percent</type>
</CustomField>
