<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Base_Quote_Id_for_Recontract_Quote_Type</fullName>
    <active>true</active>
    <description>Base Quote Id is required for Recontract Quote Type</description>
    <errorConditionFormula>AND ( 
    ISPICKVAL(Quote_Type__c, &apos;Recontract&apos;),
    ISBLANK(Base_Quote_Id__c)
)</errorConditionFormula>
    <errorDisplayField>Base_Quote_Id__c</errorDisplayField>
    <errorMessage>Base Quote Id is required for Recontract</errorMessage>
</ValidationRule>
