<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Cannot_Change_Sub_for_Account_Strategy</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
ISCHANGED(Subject),
(PRIORVALUE(Subject)) = &quot;Account Plan Update Due&quot;)</errorConditionFormula>
    <errorMessage>Unable to change the subject , please open a new task if required</errorMessage>
</ValidationRule>
