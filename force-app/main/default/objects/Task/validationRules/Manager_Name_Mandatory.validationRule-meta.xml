<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Manager_Name_Mandatory</fullName>
    <active>true</active>
    <errorConditionFormula>AND( $Profile.Name =&apos;Monster - Sales&apos;, 
ISPICKVAL(Accompanied_By__c ,&apos;With Manager&apos;)
,ISBLANK(Manager_Name__c)

)</errorConditionFormula>
    <errorDisplayField>Manager_Name__c</errorDisplayField>
    <errorMessage>Please enter the manager name</errorMessage>
</ValidationRule>
