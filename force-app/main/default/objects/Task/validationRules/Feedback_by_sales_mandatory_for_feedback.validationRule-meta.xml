<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Feedback_by_sales_mandatory_for_feedback</fullName>
    <active>false</active>
    <errorConditionFormula>AND(
$Profile.Name == &apos;Monster - Sales&apos; ,ISPICKVAL( Related_to_Inbound_Recruiter_task__c,&apos;Yes&apos;),
 ISPICKVAL(Feedback_By_Sales__c , &apos;&apos;)  
)</errorConditionFormula>
    <errorDisplayField>Feedback_By_Sales__c</errorDisplayField>
    <errorMessage>Please enter feedback if this task is related to Inbound/Recruiter Lead</errorMessage>
</ValidationRule>
