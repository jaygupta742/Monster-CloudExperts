<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>DiscountAmountValidation</fullName>
    <active>false</active>
    <description>Discount Amount should not exceeded cap amount</description>
    <errorConditionFormula>Total_Discount_Amount__c &gt; ( Product__r.Discount_Cap_Amount__c *  Quantity__c )</errorConditionFormula>
    <errorDisplayField>Adjustment_Type__c</errorDisplayField>
    <errorMessage>Discount Amount Exceeded Cap Amount</errorMessage>
</ValidationRule>
