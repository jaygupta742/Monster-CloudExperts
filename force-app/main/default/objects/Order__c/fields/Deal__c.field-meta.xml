<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Deal__c</fullName>
    <externalId>false</externalId>
    <formula>IF(
    NOT(ISBLANK(Days_Between__c)),
    IF(Days_Between__c &lt;= 365, &quot;SY&quot;, IF(Days_Between__c &gt; 365, &quot;MY&quot;, &quot;&quot;)),
    &quot;&quot;
)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <inlineHelpText>SY =If Days Between Contract Start and End Date is less than One Year,
MY=If Days Between Contract Start and End Date is More than One Year</inlineHelpText>
    <label>Deal</label>
    <required>false</required>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Text</type>
    <unique>false</unique>
</CustomField>
